# ─── AssetFlow Frontend GitIgnore ─────────────────────────────────────────

# ─── Secrets & Environment Configurations ──────────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example

# ─── Dependency Directories ────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ─── Production Builds & Bundler Output ─────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/

# ─── Logs & Debugging ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Cache & Temporary Files ───────────────────────────────────────────────
.cache/
.temp/
*.tmp
.eslintcache

# ─── Editor & System Files ─────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
