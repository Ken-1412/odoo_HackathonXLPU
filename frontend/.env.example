# ─── StockSense Frontend Environment Variables ─────────────────────────────
# Base URL for StockSense backend API
VITE_API_URL=http://localhost:5000

# EmailJS Configuration (Client-side browser SDK for OTP dispatch)
# Never place private server secrets here.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

