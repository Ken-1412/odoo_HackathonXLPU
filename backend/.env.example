# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/stocksense

# ─── Cryptographically Secure JWT Secrets ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_64_char_random_string
JWT_REFRESH_SECRET=CHANGE_ME_to_another_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Cloudinary (optional — file uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ─── Resend Email Configuration ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=StockSense <onboarding@resend.dev>
APP_URL=http://localhost:5173

# ─── EmailJS Configuration (Password Reset OTP) ────────────────────────────
# Sign up at https://www.emailjs.com to get these credentials
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ─── OmniDimension AI Voice Configuration ──────────────────────────────────
# Get your API key from https://omnidim.io/agents
OMNIDIM_API_KEY=
OMNIDIM_BASE_URL=https://omnidim.io/api/v1
OMNIDIM_DEFAULT_AGENT_ID=
OMNIDIM_WEBHOOK_SECRET=
