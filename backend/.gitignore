# ─── AssetFlow Backend GitIgnore ──────────────────────────────────────────

# ─── Secrets & Environment Configurations ──────────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example

# Keys & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks
service-account*.json
client_secret*.json
credentials.json

# ─── Dependency Directories ────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Production Builds & Output ────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── File Uploads & Storage ────────────────────────────────────────────────
uploads/
storage/
temp/
.tempmediaStorage/

# ─── Log Files ─────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Database & SQLite Dev DBs ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/dev.db
prisma/dev.db-journal

# ─── OS & Editor Files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
